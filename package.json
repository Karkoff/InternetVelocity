{
  "name": "internet-velocity",
  "version": "1.0.0",
  "description": "Medidor de velocidade da internet",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dev:electron": "vite",
    "dev:electron-simple": "electron .",
    "test:minimal": "cd electron/test-minimal && npm start",
    "build:electron": "tsc && vite build && electron-builder",
    "preview:electron": "vite build && electron --no-sandbox dist-electron/main.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^10.0.5",
    "electron": "^28.0.0",
    "electron-builder": "^26.15.3",
    "electron-store": "^11.0.2",
    "playwright": "^1.63.0",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^6.4.3",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.internetvelocity.app",
    "productName": "Internet Velocity",
    "directories": {
      "output": "release/"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Internet Velocity"
    }
  },
  "allowScripts": {
    "electron@28.3.3": true
  }
}
